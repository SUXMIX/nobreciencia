{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "nobreciencia",
    "main": "./src/index.js",
    "compatibility_date": "2026-09-05",

    "assets": {
        "directory": "./public",
        "binding": "ASSETS"
    },

    "durable_objects": {
        "bindings": [
            {
                "name": "EXPERIMENTO",
                "class_name": "ExperimentoDO"
            }
        ]
    },

    "exports": {
        "ExperimentoDO": {
            "type": "durable-object",
            "storage": "sqlite"
        }
    }
}
